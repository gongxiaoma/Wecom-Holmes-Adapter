WECHAT_BOT_ID=replace-me
WECHAT_BOT_SECRET=replace-me
# Comma-separated WeCom userid allowlist. Set the actual userid(s).
ALLOWED_USER_IDS=user1,user2
ALLOW_ALL_USERS=false

HOLMES_API_URL=http://172.16.119.92:30395
HOLMES_API_KEY=
# Leave blank to use the HolmesGPT server default model.
HOLMES_MODEL=
HOLMES_TIMEOUT_SECONDS=300

# Recommended for persistent conversations. Leave blank for in-memory dev mode.
REDIS_URL=redis://redis.sre-ai.svc.cluster.local:6379/0
SESSION_TTL_SECONDS=86400
MAX_CONCURRENT_CHATS=8
MAX_REPLY_CHARS=12000
STREAM_UPDATE_INTERVAL_SECONDS=1.0
STREAM_UPDATE_MIN_CHARS=80
LOG_LEVEL=INFO
